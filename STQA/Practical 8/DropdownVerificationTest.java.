import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.firefox.FirefoxDriver;
import org.openqa.selenium.support.ui.Select;
import org.testng.Assert;
import org.testng.annotations.AfterMethod;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

import java.time.Duration;
import java.util.List;

public class DropdownVerificationTest {

    WebDriver driver;

    @BeforeMethod
    public void setUp() {

        // Launch Firefox
        driver = new FirefoxDriver();

        // Maximize browser
        driver.manage().window().maximize();

        // Implicit wait
        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));

        // Open website
        driver.get("https://the-internet.herokuapp.com/dropdown");
    }

    @Test
    public void verifyDropdown() {

        // Locate dropdown
        WebElement dropdownElement =
                driver.findElement(By.id("dropdown"));

        // Create Select object
        Select dropdown = new Select(dropdownElement);

        // Get all items
        List<WebElement> options = dropdown.getOptions();

        // Count items
        System.out.println("Total number of items: " + options.size());

        Assert.assertEquals(
                options.size(),
                3,
                "Incorrect number of dropdown items"
        );

        // Verify default selected value
        String defaultValue =
                dropdown.getFirstSelectedOption().getText();

        System.out.println("Default selected value: " + defaultValue);

        Assert.assertEquals(
                defaultValue,
                "Please select an option",
                "Incorrect default value"
        );

        // Select Option 1 by visible text
        dropdown.selectByVisibleText("Option 1");

        String selectedValue =
                dropdown.getFirstSelectedOption().getText();

        System.out.println("Selected value: " + selectedValue);

        Assert.assertEquals(
                selectedValue,
                "Option 1",
                "Option 1 was not selected"
        );

        // Select Option 2 by index
        dropdown.selectByIndex(2);

        selectedValue =
                dropdown.getFirstSelectedOption().getText();

        System.out.println("Selected by index: " + selectedValue);

        Assert.assertEquals(
                selectedValue,
                "Option 2",
                "Option 2 was not selected"
        );

        // Select Option 1 by value
        dropdown.selectByValue("1");

        selectedValue =
                dropdown.getFirstSelectedOption().getText();

        System.out.println("Selected by value: " + selectedValue);

        Assert.assertEquals(
                selectedValue,
                "Option 1",
                "Option 1 was not selected by value"
        );
    }

    @AfterMethod
    public void tearDown() {

        if (driver != null) {
            driver.quit();
        }
    }
}
